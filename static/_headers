# Pages are served without extension: revalidate on every request, but allow caching.
/*
  Cache-Control: max-age=0, must-revalidate

# CSS and JS are referenced with ?v=<hash>: safe to cache for a year.
/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts change (at most) with a redesign: cache like the hashed assets.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Published .stxt sources: readable as plain text, but not competing with their HTML.
/*.stxt
  Content-Type: text/plain; charset=utf-8
  X-Content-Type-Options: nosniff
  X-Robots-Tag: noindex
