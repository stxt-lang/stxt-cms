## Site index (the _index.stxt page) rendered as the left navigation column.
#if($index)
	<nav class="site-index" aria-label="${lang.get("nav.index")}">
	#foreach($node in $index.children)
		#if(${node.canonicalName} == "subheader")
			<h2 class="site-index-title">$node.text</h2>
		#elseif(${node.canonicalName} == "link")
			#if($node.getChild('url'))
				<a class="site-index-link" href="${node.getChild('url').getText()}" target="_blank" rel="noopener noreferrer">${node.text}</a>
			#else
				## Pages whose Metadata carries a Version (the five specifications) show it on the right
				#set($page_name = ${node.getChild('page').getText()})
				#set($page_doc = $pages.get($page_name))
				#set($page_version = "")
				#if($page_doc && $page_doc.getChild("metadata") && $page_doc.getChild("metadata").getChild("version"))
					#set($page_version = $page_doc.getChild("metadata").getChild("version").value)
				#end
				<a class="site-index-link#if(${doc_name}==$page_name) selected#end" href="$page_name"#if(${doc_name}==$page_name) aria-current="page"#end>${node.text}#if($page_version != "")<span class="site-index-version">$page_version</span>#end</a>
			#end
		#end
	#end
	</nav>
#end
