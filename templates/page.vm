<!DOCTYPE html>
#parse("/init.vm")
<html lang="${lang.get("lang")}">
	<head>#parse("/head.vm")</head>

	<body>
		#parse("/site_header.vm")
## The home page banner (hero.vm) is disabled since 2026-09-13; uncomment to bring it back.
##		#if(${doc_name} == "index")
##			#parse("/hero.vm")
##		#end
		<div class="layout">
			<aside class="sidebar">
				#parse("/sidebar.vm")
			</aside>
			<main class="content">
				<article>
					#set($numPart = 0)
					#foreach($node in ${doc.children})
						#parse("/node.vm")
					#end
				</article>
				#parse("/navigation.vm")
			</main>
			<aside class="toc">
				#parse("/toc.vm")
			</aside>
		</div>
		#parse("/footer.vm")
	</body>
</html>
