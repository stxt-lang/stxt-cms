#if(${node.normalizedName} == "html")
	${node.text}
#elseif(${node.normalizedName} == "content" || ${node.normalizedName} == "text")
	${wiki.render($node.text)}
#elseif(${node.normalizedName} == "preamble")
	<div class="preamble">${wiki.render($node.text)}</div>
#elseif(${node.normalizedName} == "header")
	<h1><a id="index_${numPart}"></a>$node.text</h1>
	#set($numPart = $numPart + 1)
#elseif(${node.normalizedName} == "subheader")
	## Two anchors per section heading: the stable id derived from the title (Utils.headingId:
	## "s4-3" for "4.3 ...", a slug otherwise) is the one content links and toc.vm use; the
	## positional index_N is kept so old links keep working.
	#set($hid = $utils.headingId($node.text))
	<h2#if($hid != "") id="$hid"#end><a id="index_${numPart}"></a>$node.text</h2>
	#set($numPart = $numPart + 1)
#elseif(${node.normalizedName} == "subsubheader")
	#set($hid = $utils.headingId($node.text))
	<h3#if($hid != "") id="$hid"#end><a id="index_${numPart}"></a>$node.text</h3>
	#set($numPart = $numPart + 1)
#elseif(${node.normalizedName} == "code")
	## STXT block: wrapped already (copy-code.js adds its button to an existing wrapper) and
	## with a link that opens the block as a new document in the playground ("#d=" fragment).
	## The named target reuses one playground tab for every click; no rel="noopener", since it
	## would put the tab in another browsing context group and defeat the reuse.
	<div class="code-wrapper"><pre class="language-stxt"><code class="language-stxt">${utils.escapeHtml($node.text)}</code></pre><a class="play-code-link" href="${utils.escapeHtml($utils.playgroundUrl($node.text, $doc.getText()))}" target="stxt-play" title="${lang.get("code.playground")}" aria-label="${lang.get("code.playground")}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="6 3 20 12 6 21 6 3"></polygon></svg></a></div>
#elseif(${node.normalizedName} == "grammar")
	<pre class="language-ebnf"><code class="language-ebnf">${utils.escapeHtml($node.text)}</code></pre>
#elseif(${node.normalizedName} == "listing")
	<pre class="listing"><code>${utils.escapeHtml($node.text)}</code></pre>
#elseif(${node.normalizedName} == "assert")
	<div class="row">
		<div class="assert">${wiki.render($node.text)}</div>
	</div>
#elseif(${node.normalizedName} == "alert")
	<div class="row">
		<div class="alert">${wiki.render($node.text)}</div>
	</div>
#elseif(${node.normalizedName} == "link")
	<div class="link">
	#if($node.getChild('url'))
		## External link (Url instead of Page): opens in a new tab, never "selected"
		<a href="${node.getChild('url').getText()}" target="_blank" rel="noopener noreferrer">${node.text}</a>
	#else
		<a href="${node.getChild('page').getText()}" #if(${doc_name}==${node.getChild('page').getText()}) class="selected"  #end>${node.text}</a>
	#end
	</div>
#end
