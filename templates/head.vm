    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>${doc.getText()}</title>
#if($meta && $meta.getChild("description"))
	<meta name="description" content="${meta.getChild("description").text}">
#end
#if($meta && !$meta.getChildren("author").isEmpty())
	<meta name="author" content="#foreach($a in $meta.getChildren("author"))$a.value#if($foreach.hasNext), #end#end">
#end

	<link rel="icon" href="/favicon.ico?v=${utils.assetHash('/favicon.ico')}" sizes="48x48">
	<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=${utils.assetHash('/favicon-32.png')}">
	<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png?v=${utils.assetHash('/favicon-16.png')}">
	<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=${utils.assetHash('/apple-touch-icon.png')}">
	<link rel="manifest" href="/site.webmanifest">

	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Russo+One&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/css/site.css?v=${utils.assetHash('/css/site.css')}">
		
	#if(${lang.get("lang")} == "en")
		<link rel="alternate" hreflang="es" href="https://stxt.dev/es/${doc_name}" />
		#set($indexPage = "/")
	#end
		
	#if(${lang.get("lang")} == "es")
		<link rel="alternate" hreflang="en" href="https://stxt.dev/${doc_name}" />
		#set($indexPage = "/es")
	#end
	
	<link rel="alternate" hreflang="x-default" href="https://stxt.dev/${doc_name}" />
