## Sticky site header: brand (Russo One, the identity font), section links, language
## switch and a link to the page source. Replaces the old top_header.vm + top_bar.vm.
<header class="site-header">
	<div class="site-header-inner">
		<a class="brand" href="$indexPage" title="STXT"><span class="brand-name">STXT</span></a>
		<nav class="site-nav" aria-label="${lang.get("nav.site")}">
			<a href="$indexPage" #if(${doc_name} == "index")aria-current="page"#end>${lang.get("menu.hello")}</a>
			<a href="tutorial" #if(${doc_name} == "tutorial")aria-current="page"#end>${lang.get("menu.tutorial")}</a>
			<a href="tools" #if(${doc_name} == "tools")aria-current="page"#end>${lang.get("menu.tools")}</a>
			<a href="faq" #if(${doc_name} == "faq")aria-current="page"#end>${lang.get("menu.faq")}</a>
			<a href="https://play.stxt.dev" target="stxt-play">${lang.get("menu.playground")}</a>
			<a href="https://github.com/orgs/stxt-lang/discussions" target="_blank" rel="noopener noreferrer">${lang.get("menu.feedback")}</a>
			<a href="https://github.com/stxt-lang" target="_blank" rel="noopener noreferrer" title="${lang.get("menu.github")}">GitHub</a>
		</nav>
		<div class="site-actions">
			<span class="lang-switch">
			## Root-relative targets, "/" and "/es/" for the home page (never "/index", a 301)
			#if(${doc_name} == "index")
				#set($switchEn = "/")
				#set($switchEs = "/es/")
			#else
				#set($switchEn = "/${doc_name}")
				#set($switchEs = "/es/${doc_name}")
			#end
			#if(${lang.get("lang")} == "es")
				<b lang="es">ES</b><a lang="en" hreflang="en" href="$switchEn" title="${lang.get("menu.lang.en")}">EN</a>
			#end
			#if(${lang.get("lang")} == "en")
				<a lang="es" hreflang="es" href="$switchEs" title="${lang.get("menu.lang.es")}">ES</a><b lang="en">EN</b>
			#end
			</span>
			<a class="source-link" href="https://github.com/stxt-lang/stxt-lang/blob/master/${lang.get("lang")}/${doc_name}.stxt" target="${doc_name}" title="${doc_name}.stxt">.stxt</a>
		</div>
	</div>
</header>
