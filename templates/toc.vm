## "On this page": the section headings of the current page, as the right column.
## Anchor ids follow node.vm ($numPart counts header, subheader and subsubheader alike).
#set($tocCount = 0)
#foreach($node in ${doc.children})
	#if(${node.normalizedName} == "subheader")
		#set($tocCount = $tocCount + 1)
	#end
#end
#if($tocCount > 1)
	#set($tocN = 0)
	<nav class="page-toc" aria-label="${lang.get("toc.title")}">
		<h2 class="page-toc-title">${lang.get("toc.title")}</h2>
		#foreach($node in ${doc.children})
			#if(${node.normalizedName} == "header")
				#set($tocN = $tocN + 1)
			#elseif(${node.normalizedName} == "subheader")
				<a href="#index_${tocN}">$node.text</a>
				#set($tocN = $tocN + 1)
			#elseif(${node.normalizedName} == "subsubheader")
				<a class="l3" href="#index_${tocN}">$node.text</a>
				#set($tocN = $tocN + 1)
			#end
		#end
	</nav>
#end
