<footer class="site-footer">${lang.get("foot.1")}</footer>
## All scripts are decorative (syntax highlighting, copy buttons, current section
## in the page index): defer keeps them
## off the parser's critical path. Order is preserved among deferred scripts, and
## Prism's DOMContentLoaded highlight runs after every grammar has loaded.
## STXT is not highlighted by Prism: stxt-highlight.js is the static highlighter of
## @stxt-lang/editor, unmodified, and highlight-stxt.js applies it to the Code blocks.
<script defer src="${utils.assetPath('/js/prism-core.min.js')}"></script>
<script defer src="${utils.assetPath('/js/prism-languages.min.js')}"></script>
<script defer src="${utils.assetPath('/js/prism-ebnf.js')}"></script>
<script defer src="${utils.assetPath('/js/stxt-highlight.js')}"></script>
<script defer src="${utils.assetPath('/js/highlight-stxt.js')}"></script>
<script defer src="${utils.assetPath('/js/copy-code.js')}"></script>
<script defer src="${utils.assetPath('/js/page-toc.js')}"></script>
